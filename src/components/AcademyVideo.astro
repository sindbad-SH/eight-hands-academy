---
import { academyVideo as video } from '../data/video';
import { withBase } from '../data/site';
// Only the file is required; poster, captions and transcript are used when supplied.
const ready = video.approved && video.src.trim() !== '';
if (video.approved && !ready) throw new Error('Approved video requires a source file.');
---
{ready && <section aria-labelledby="academy-video-heading" class="bg-navy text-stone">
  <div class="container-content py-section-sm max-w-4xl">
    <h2 id="academy-video-heading" class="font-display text-3xl text-stone mb-6">{video.title}</h2>
    <video controls playsinline preload="none" poster={video.poster ? withBase(video.poster) : undefined} aria-label={video.title} class="w-full aspect-video bg-navy" crossorigin="anonymous">
      <source src={withBase(video.src)} />
      {video.captions && <track kind="captions" src={withBase(video.captions)} srclang="en" label="English" default />}
      <p><a href={withBase(video.src)}>Download the video</a>.</p>
    </video>
    {video.transcript && <a href={withBase(video.transcript)} class="inline-block mt-4 underline text-stone">Read the video transcript</a>}
  </div>
</section>}


<!-- Placement preview for review only: hidden unless the page URL has ?video-preview. Removed automatically once a real video is set. -->
{!ready && <section id="video-slot-preview" class="bg-navy text-stone hidden" aria-hidden="true">
  <div class="container-content py-section-sm max-w-4xl">
    <h2 class="font-display text-3xl text-stone mb-6">{video.title}</h2>
    <div class="w-full aspect-video border-2 border-dashed border-gold/60 flex items-center justify-center text-gold/80 font-accent uppercase tracking-[0.16em] text-sm text-center px-4">60-second homepage video goes here</div>
  </div>
</section>}
{!ready && <script is:inline>if (location.search.includes('video-preview')) { var e = document.getElementById('video-slot-preview'); if (e) e.classList.remove('hidden'); }</script>}
