---
import { pricing as p } from '../data/pricing';
// Display only — no forms, no payment fields. Data and holds live in src/data/pricing.ts.
const card = 'border border-stone/20 bg-white/[0.04] p-6 text-left';
const tiles = [
  ['Membership', p.membership],
  ['Base program', p.base],
  ['Neurohacking', p.neurohacking],
  ['Tai Chi', p.taiChi],
] as const;
---
{p.approved && <section aria-labelledby="pricing-heading" class="mb-10">
  <h3 id="pricing-heading" class="font-display text-3xl text-stone text-center mb-6">Tuition</h3>
  <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4">
    {tiles.map(([name, t]) => <div class={card}>
      <p class="font-accent text-sm uppercase tracking-[0.14em] text-gold">{name}</p>
      <p class="mt-3 text-3xl text-stone">${t.amount}<span class="text-base text-stone/70"> / {t.unit}</span></p>
      <p class="mt-2 text-sm text-stone/75">{t.note}</p>
    </div>)}
  </div>
  <div class={`mt-4 ${card}`}>
    <p class="font-accent text-sm uppercase tracking-[0.14em] text-gold">Member rates · personal lessons</p>
    <p class="mt-1 text-sm text-stone/75">{p.memberLessons.note}</p>
    <dl class="mt-4 grid grid-cols-2 sm:grid-cols-5 gap-3">
      {p.memberLessons.terms.map(({ term, amount }) => <div>
        <dt class="text-sm text-stone/75">{term}</dt>
        <dd class="text-2xl text-stone">${amount}<span class="text-sm text-stone/70"> / mo</span></dd>
      </div>)}
    </dl>
  </div>
  {p.showCancellation && p.cancellation && <p class="mt-4 text-sm text-stone/70 text-left">{p.cancellation}</p>}
  <p class="mt-6 text-stone/80">Your free assessment recommends the program that fits.</p>
</section>}
