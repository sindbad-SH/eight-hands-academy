---
import Base from '../layouts/Base.astro';
import PeelHero from '../components/home/PeelHero.astro';
import CompassOfSelfGovernance from '../components/CompassOfSelfGovernance.astro';
import NewsFlyout from '../components/NewsFlyout.astro';
import HighlightEyebrow from '../components/HighlightEyebrow.astro';
import GoldArrowLink from '../components/GoldArrowLink.astro';
import DevelopmentWithDirection from '../components/DevelopmentWithDirection.astro';
import TopoTexture from '../components/TopoTexture.astro';
import Carousel from '../components/Carousel.astro';
import ParallaxPhoto from '../components/ParallaxPhoto.astro';
import ClaimRotator from '../components/ClaimRotator.astro';
import { BOOKING_URL, PROGRAMS_URL, withBase, CONTACT } from '../data/site';
import { events } from '../data/events';

const differentiators = [
  ['Confidence & Focus', 'Outcomes you can see — clearer attention, steadier resolve, and the discipline to follow through.'],
  ['A Mentorship Model', 'Private instruction is the education: assessment, guidance, and accountability at the center.'],
  ['Education, Not Combat', 'Martial arts is the medium; self-governance is the curriculum.'],
  ['Leadership & Accountability', 'Group training is the application laboratory — where capability becomes contribution.'],
];

// The Twelve Domains — the academy's educational model (client copy, Jeanette 2026-06-08). Name + one-line
// aphorism here on the home page; the full developmental descriptions live on /the-twelve-houses.
const domains: [string, string][] = [
  ['Origins', 'Every journey begins with a reason to continue.'],
  ['Foundations', 'Growth often arrives disguised as hunger.'],
  ['Confidence', 'Confidence emerges when action meets uncertainty.'],
  ['Relationship', 'Connection reveals what cannot be discovered alone.'],
  ['Communication', 'What is expressed shapes what is remembered.'],
  ['Perspective', 'Perspective changes the meaning of the path.'],
  ['Purpose', 'Purpose gives direction to effort.'],
  ['Contribution', 'What serves the individual eventually serves something greater.'],
  ['Principle', 'Principles endure when circumstances change.'],
  ['Exploration', 'Freedom expands with responsibility.'],
  ['Integration', 'Wholeness is found not in perfection, but participation.'],
  ['Resonance', 'Resonance occurs when understanding becomes influence.'],
];


// Age-based program pathways → dedicated pages (client 2026-06-08).
const programs: [string, string, string][] = [
  ['Early Youth Programs', 'Ages 2–6', '/programs/early-youth'],
  ['Youth Programs', 'Ages 7–13', '/programs/youth'],
  ['Adult Programs', 'Ages 14+', '/programs/adult'],
  ['Events & Gatherings', 'Students, Families & Guests', '/community/events'],
];

// Programs section (client brief 2026-10): [name, ages, description, detail page]. Descriptions are the brief's own
// wording; the same five programs are listed on the Qi-House site, which carries the schedule.
const programCards: [string, string | null, string, string][] = [
  ['Early Youth', 'Ages 2–6', 'Foundational skills — coordination, awareness, communication, respect, and self-control — built through structured, age-appropriate activities.', '/programs/early-youth'],
  ['Youth', 'Ages 7–13', 'Confidence, focus, communication, and accountability, developed through individualized instruction and group training.', '/programs/youth'],
  ['Adult', 'Ages 14+', 'Martial arts training combined with personal development: self-defense, communication, leadership, and resilience.', '/programs/adult'],
  ['Summer Academy', null, 'Training extended beyond the classroom through challenging activities, community engagement, and leadership opportunities.', '/community/summer-academy'],
  ['Private Instruction', null, 'One-on-one guidance with customized training, progress planning, and accountability.', '/learning/individualized-instruction'],
];

// Testimonials — the six reviews published on qihouse8handsmartialarts.com (Google reviews), verbatim. Rating
// summary (4.7 / 13) is the figure that site publishes in its structured data. [name, paragraphs]
const RATING = { value: '4.7', count: 13 };
const reviews: [string, string[]][] = [
  ['Taylor I', [
    `I’ve had the opportunity to work with Jeanette, and one of the things that stands out most is how unique her approach is. Her martial arts instruction goes far beyond just learning techniques. It helps you build strength, resilience, confidence, and a deeper sense of autonomy in your own body.`,
    `Through working with her, I felt like I was developing not only physical skills, but also stronger mental, emotional, and physical boundaries. Jeanette has a way of teaching that helps you feel more grounded, capable, and empowered, and that has been incredibly valuable. If you’re looking for martial arts training that supports both self-defense and personal growth, I highly recommend working with her.`,
  ]],
  ['Rex Finfgeld', [
    `I find the Neurohacking classes both helpful and challenging. There's always something to learn. The system is dynamic, expansive, and deep. Over time a person can develop a deeper understanding of themselves, others, and the situations around them. This applies to personal, social, business, and more. Jeannette is a wonderful teacher who is personable and incredibly knowledgeable. She takes the time to explain things in detail and answer everyone's questions. For anyone looking to learn and grow, I wholeheartedly recommend getting involved in these classes. Wishing you the best on your life journey!`,
  ]],
  ['Aife Rozen', [
    `Qi House has been incredibly helpful. Sensei Jeanette has been wonderful with designing a method that accommodates my disabilities and I’ve made excellent progress in just three months.`,
  ]],
  ['Sindbad Horizon', [
    `If you're in the Longmont area and even remotely curious about martial arts, stop overthinking it and just check it out.`,
    `The Qi House is stunning. It feels intentional, clean, and serious in the best way. But what keeps me coming back is the people. Jeanette has a way of breaking things down that actually sticks, and the energy in class pushes you without making you feel like you're drowning.`,
    `Genuinely wouldn't train anywhere else. Highly recommend.`,
  ]],
  ['Cole Wilson', [
    `Fantastic place to learn about mind and body, the teachings here have a way of going as deep and far as you are willing to go with them. From physical self defense to self psychology and navigating the everyday.`,
  ]],
  ['Kelsey Cain', [
    `8 Hands Neurohacking classes have been genuinely transformative for me. The material goes far beyond theory and gives practical, strategic tools that I’ve been able to apply directly to real business decisions. One of the biggest benefits has been learning how to read people more accurately. The classes help me understand mental processes by identifying behavioral patterns and decision-making cues in others and I’ve become much more intentional in how I approach, analyze, and develop solutions. It has made communications clearer and negotiations more effective. I now feel more confident breaking down why people think the way they do and adjusting my approach to interactions in a way that’s ethical, grounded, and strategic.`,
    `8 Hands provides deep insight and practical frameworks that can be applied in multiple aspects of our day to day interactions. If you’re serious about improving your mindset, decision-making, and understanding of human behavior, especially in a business context, these classes are absolutely worth it.`,
  ]],
];

// FAQ — shared with qihouse8handsmartialarts.com so both sites answer the same way (client brief 2026-10).
const faqs: [string, string][] = [
  ['What makes Eight Hands Martial Arts Academy different from other martial arts schools?', 'Eight Hands is more than a martial arts training facility. Martial arts is used as a medium for developing self-governance — the ability to think clearly, act responsibly, and make purposeful decisions. Students develop confidence, discipline, focus, communication skills, and leadership through individualized instruction and community participation.'],
  ['What age groups does Eight Hands serve?', 'Eight Hands offers programs for children, youth, and adults. Early Youth Programs are designed for ages 2–6, Youth Programs for ages 7–13, and Adult Programs for ages 14 and above. Each program is tailored to the developmental needs, goals, and abilities of the student.'],
  ['Do I need martial arts experience to join?', 'No prior martial arts experience is required. Students begin with an assessment to understand their goals, current abilities, and readiness. Instruction is personalized to meet each student where they are and provide an appropriate path for growth.'],
  ['What will my child learn besides martial arts skills?', 'Students develop skills that extend beyond physical training, including confidence, focus, respect, communication, self-control, responsibility, problem-solving, and leadership. The goal is to help students build habits that support success at home, in school, and within their communities.'],
  ['How does training support adult personal development?', 'Adult programs are designed around individual goals and may include martial arts, self-defense, communication, leadership, resilience, personal effectiveness, and self-awareness. Students learn practical skills while developing greater confidence, clarity, and the ability to respond effectively to life’s challenges.'],
  ['What happens during the assessment process?', 'The assessment is a conversation designed to understand your goals, challenges, and desired outcomes. It allows the academy to recommend the most appropriate program and developmental pathway. The goal is to ensure that each student begins in an environment where they can grow and succeed.'],
];
---

<Base home description="Eight Hands Martial Arts Academy in Longmont, CO — a martial arts education in self-governance for kids, youth, and adults since 1992. Schedule a free assessment.">
  <!-- 1 · Peel Hero -->
  <PeelHero />
  <section class="bg-navy text-stone border-t border-stone/10">
    <div class="container-content py-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="font-display italic text-lg sm:text-xl text-stone/85">A Martial Arts Education in Self-Governance.</p>
      <div class="flex gap-3">
        <a href={BOOKING_URL} target="_blank" rel="noopener" class="btn-accent">Schedule Your Free Assessment</a>
        <a href={withBase('/admissions#visit')} class="btn-ghost !border-stone/40 !text-stone hover:!bg-stone hover:!text-navy">Observe a Class</a>
      </div>
    </div>
  </section>

  <!-- 2 · Founding statement (navy text, no photos — matches source section 2) -->
  <section class="bg-navy text-stone relative overflow-hidden">
    <TopoTexture id="topo-founding" />
    <div class="container-content relative py-section-sm lg:py-section grid lg:grid-cols-[0.7fr_1.8fr] gap-8 lg:gap-12 items-start">
      <div class="reveal pt-4 hidden lg:block"><span class="block w-24 h-px bg-red"></span></div>
      <p class="reveal font-display text-2xl sm:text-3xl lg:text-[2.4rem] leading-[1.35] text-stone">
        Eight Hands develops individuals capable of governing themselves before they set out to influence
        the world. The outcome is practical: greater confidence, sharper focus, deeper awareness, and the
        discipline to act with accountability. Martial arts is the medium; the education is in how you carry
        yourself — a practice grounded in disciplined study since 1992.
      </p>
    </div>
  </section>

  <!-- 3 · The Compass of Self-Governance (replaces the StatMap "An Environment That Inspires" per client) -->
  <CompassOfSelfGovernance />

  <!-- 4 · A Curriculum that Challenges — bespoke layered photo cluster + Cohort Constellation -->
  <section class="bg-navy text-stone relative overflow-hidden">
    <TopoTexture id="topo-curric" />
    <div class="container-content relative py-section">
      <div class="grid lg:grid-cols-2 gap-14 lg:gap-20 items-start">
        <!-- Layered cluster: large primary top-right + big secondary overhanging bottom-left (crosses past
             the primary's edge and hangs below it). Top-aligned with the heading; taller than the copy. -->
        <div class="relative reveal min-h-[320px] lg:min-h-[420px] lg:order-2">
          <ParallaxPhoto
            img="/img/instruction-3.jpg" imgAlt="An instructor coaching two students through a partner blocking drill in the studio."
            alt="[IMAGE — primary (BACK layer) · 1040×780px (4:3) · student mid-practice, focused and composed]"
            frameClass="aspect-[4/3] w-[88%] ml-auto"
            parallax={-104}
            innerClass="!text-xs"
          />
          <ParallaxPhoto
            img="/img/mentoring-1.jpg" imgAlt="An instructor watches as two young students in white uniforms practice a raised-arm stance."
            alt="[IMAGE — secondary (FRONT layer, overhangs bottom-left) · 760×570px (4:3) · instructor guiding a student one-on-one]"
            frameClass="absolute -bottom-6 left-0 lg:-left-8 w-[58%] aspect-[4/3] z-20 ring-[10px] ring-navy"
            parallax={-100}
            innerClass="!p-3 !text-[10px]"
          />
        </div>
        <div class="reveal lg:order-1">
          <HighlightEyebrow pre="A Curriculum that" mark="Challenges" class="mb-5 text-stone/70" />
          <h2 class="text-3xl lg:text-4xl text-stone mb-6">Training that builds discipline, focus, and resolve.</h2>
          <p class="text-stone/80 mb-8 leading-relaxed">
            The work begins with the individual. Private instruction is the education — a mentor assesses
            where you are, guides where you are going, and holds you accountable along the way. Group
            training is the laboratory where that capability is applied. Over more than three decades, the
            method has produced people who think more clearly, choose more deliberately, and lead with
            character.
          </p>
          <GoldArrowLink href="/learning" text="Learn More" />
        </div>
      </div>

    </div>
  </section>

  <!-- 4b · Development With Direction (4-stage journey + crossfading image) — replaces the cohort constellation per client -->
  <DevelopmentWithDirection />

  <!-- 4c · Programs (client brief 2026-10) — the five programs + tuition line + cross-link to the schedule site -->
  <section id="programs" class="bg-navy text-stone relative overflow-hidden">
    <TopoTexture id="topo-programs" />
    <div class="container-content relative z-10 py-section">
      <div class="text-center max-w-2xl mx-auto mb-10 reveal">
        <HighlightEyebrow pre="Our" mark="Programs" class="justify-center mb-4 text-stone/70" />
        <h2 class="text-3xl lg:text-4xl text-stone mt-2 text-balance">Programs for every age, from early youth to adult.</h2>
      </div>
      <!-- 6-col grid, cards span 2: three on the first row, the last two centred beneath -->
      <div class="grid sm:grid-cols-2 lg:grid-cols-6 gap-5 reveal">
        {programCards.map(([name, ages, desc, href], i) => (
          <a href={withBase(href)} class:list={['group flex flex-col border border-stone/15 bg-white/[0.04] p-6 hover:border-gold transition-colors lg:col-span-2', i === 3 && 'lg:col-start-2']}>
            {ages && <div class="font-accent uppercase tracking-[0.16em] text-[11px] text-gold/80 mb-2">{ages}</div>}
            <h3 class="font-display text-2xl text-stone mb-3 group-hover:text-gold transition-colors">{name}</h3>
            <p class="text-stone/75 text-sm leading-relaxed">{desc}</p>
          </a>
        ))}
      </div>
      <div class="mt-10 text-center reveal">
        <p class="text-stone/80 mb-6">Tuition is set at your free assessment, based on the program and schedule you choose.</p>
        <a href={PROGRAMS_URL} target="_blank" rel="noopener" class="group inline-flex items-center gap-3 font-accent text-xs uppercase tracking-[0.18em] font-semibold text-gold hover:text-stone transition-colors">
          See programs and class schedule
          <svg width="22" height="10" viewBox="0 0 22 10" fill="none" stroke="currentColor" stroke-width="1.5" class="transition-transform duration-200 group-hover:translate-x-1"><line x1="0" y1="5" x2="20" y2="5" /><polyline points="15,1 20,5 15,9" /></svg>
        </a>
        <span class="hidden sm:inline text-stone/30 mx-4" aria-hidden="true">·</span>
        <a href={withBase('/schedule')} class="group mt-4 sm:mt-0 inline-flex items-center gap-3 font-accent text-xs uppercase tracking-[0.18em] font-semibold text-gold hover:text-stone transition-colors">
          Weekly schedule
          <svg width="22" height="10" viewBox="0 0 22 10" fill="none" stroke="currentColor" stroke-width="1.5" class="transition-transform duration-200 group-hover:translate-x-1"><line x1="0" y1="5" x2="20" y2="5" /><polyline points="15,1 20,5 15,9" /></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- 5 · A Truly International Community — INSET assembly photo + left copy/age-boxes + right overlaid photos + hover-enlarge video (1:1 with source) -->
  <section class="bg-navy text-stone relative overflow-hidden">
    <TopoTexture id="topo-community" />
    <div class="container-content relative z-10 py-section">
      <!-- Inset assembly photo: navy gutters on all sides (NOT edge-to-edge); clip-and-drift parallax -->
      <div class="relative reveal mb-14 lg:mb-20">
        <ParallaxPhoto
          img="/img/community-1.jpg" imgAlt="Children in white uniforms practicing open-hand strikes together during a group class."
          alt="[IMAGE — community assembly / gathering · INSET (navy gutters all sides) · 1500×625px (≈12:5) · participation, belonging across ages]"
          frameClass="aspect-[12/5]"
          parallax={-52}
          innerClass="!text-xs"
        />
      </div>

      <!-- Two columns — LEFT: heading + copy + Learn More + three age/track boxes · RIGHT: overlaid clip-drift photos; video pill BELOW in open space -->
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-start">
        <div class="reveal lg:order-2">
          <h2 class="text-3xl lg:text-4xl text-stone mb-6 leading-tight">Development Happens <span class="bg-red text-stone px-2 box-decoration-clone">Together</span></h2>
          <p class="text-stone/80 mb-7 leading-relaxed">Confidence, communication, and leadership are strengthened through participation. Training alongside others—across ages, backgrounds, and levels of experience—creates opportunities to develop awareness, accountability, and a sense of belonging. The community becomes part of the educational experience, helping students learn not only from instructors, but from one another.</p>
          <GoldArrowLink href="/community" text="Learn More" class="mb-9 text-stone" />
          <div class="space-y-3 max-w-md">
            {programs.map(([t, a, href]) => (
              <a href={withBase(href)} class="flex items-center gap-4 border border-stone/20 px-5 py-4 hover:border-gold transition-colors">
                <span class="w-9 h-9 border border-gold/50 flex items-center justify-center text-gold shrink-0">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M3 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M17 11l2 2 4-4" /></svg>
                </span>
                <span class="font-accent text-sm uppercase tracking-[0.14em] text-stone">{t}<span class="text-stone/45 normal-case tracking-normal"> · {a}</span></span>
              </a>
            ))}
          </div>
        </div>

        <div class="reveal lg:order-1">
          <!-- Layered cluster: large PORTRAIT primary top-right + big LANDSCAPE secondary that overhangs
               bottom-left, crossing LEFT past the column into the copy's space (the reference's layered overlap). -->
          <div class="relative min-h-[440px] lg:min-h-[600px]">
            <ParallaxPhoto
              img="/img/group-1.jpg" imgAlt="Three students in uniform practicing kicks and guard stances across the training floor."
              alt="[IMAGE — community life (primary) · PORTRAIT 5:6 · 1000×1200px · members across ages training together]"
              frameClass="w-[74%] ml-auto aspect-[5/6]"
              parallax={-104}
              innerClass="!text-xs"
            />
            <ParallaxPhoto
              img="/img/reflection-1.jpg" imgAlt="Students kneeling in quiet reflection on the training floor."
              alt="[IMAGE — shared moment (secondary) · LANDSCAPE 4:3 · 900×675px]"
              frameClass="absolute -bottom-6 left-0 lg:-left-20 w-[62%] aspect-[4/3] z-20 ring-[10px] ring-navy"
              parallax={-100}
              innerClass="!p-3 !text-[10px]"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 6 · Life at the Qi-House (= source panel-04 "Life on the Mountain") — full-bleed feature: bg + centered text + red icon CTA; placed directly after Community to match source order -->
  <section class="relative bg-navy text-stone overflow-hidden min-h-[70vh] flex items-center">
    <div class="absolute inset-x-0 -top-16 -bottom-16 bg-gradient-to-b from-navy-700 via-navy to-navy-900" data-parallax="-48" aria-hidden="true">
      <img src={withBase('/img/environment-1.jpg')} alt="" class="absolute inset-0 w-full h-full object-cover" />
    </div>
    <div class="container-content relative z-10 py-section text-center max-w-2xl mx-auto reveal">
      <HighlightEyebrow pre="Life at the" mark="Qi-House" class="justify-center text-stone/80 mb-6" />
      <h2 class="text-3xl lg:text-4xl text-stone mb-6">An environment designed for development.</h2>
      <p class="text-stone/80 mb-9 leading-relaxed">The space itself is part of the education — arranged to cultivate presence, focus, and the deliberate practice of awareness. Most people feel the difference the moment they step inside.</p>
      <a href={CONTACT.mapUrl} target="_blank" rel="noopener" class="btn-accent inline-flex items-center gap-2">
        <svg width="14" height="16" viewBox="0 0 14 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M7 1C3.7 1 1 3.6 1 6.8 1 11 7 15 7 15s6-4 6-8.2C13 3.6 10.3 1 7 1z" /><circle cx="7" cy="6.8" r="2" /></svg>
        Visit the Qi-House
      </a>
    </div>
  </section>

  <!-- 8 · A Life Changing Adventure — composed 2-col (1:1 panel-05): LEFT offset photo pair + ▶ pill · RIGHT copy + claim-rotator card -->
  <section class="bg-navy text-stone relative overflow-hidden">
    <TopoTexture id="topo-adventure" />
    <div class="container-content relative z-10 py-section grid lg:grid-cols-2 gap-14 lg:gap-20 items-start">
      <!-- Offset photo pair (secondary overlaps bottom-right) + video pill in open space below -->
      <div class="reveal lg:order-2">
        <!-- Layered cluster: large primary top-left + big secondary overhanging bottom-right, crossing right toward the copy. -->
        <div class="relative min-h-[320px] lg:min-h-[420px]">
          <ParallaxPhoto
            img="/img/form-1.jpg" imgAlt="A student in a white uniform holding a forms stance with an open-hand guard."
            alt="[IMAGE — meaningful challenge / leadership · LANDSCAPE 4:3 · 1040×780px]"
            frameClass="aspect-[4/3] w-[88%]"
            parallax={-104}
            innerClass="!text-xs"
          />
          <ParallaxPhoto
            img="/img/service-1.jpg" imgAlt="Two instructors demonstrating a wooden staff exchange beside the Eight Hands booth at an outdoor community fair."
            alt="[IMAGE — service / outdoor development · LANDSCAPE 4:3 · 900×675px]"
            frameClass="absolute -bottom-6 right-0 lg:-right-12 w-[58%] aspect-[4/3] z-20 ring-[10px] ring-navy"
            parallax={-100}
            innerClass="!p-3 !text-[10px]"
          />
        </div>
      </div>

      <!-- Copy + Learn More + rotating claim card (icon + title + body + dots + pause) -->
      <div class="reveal lg:order-1">
        <HighlightEyebrow pre="A Meaningful" mark="Challenge" class="mb-5 text-stone/70" />
        <h2 class="text-3xl lg:text-4xl text-stone mb-6">Leadership that reaches beyond the training floor.</h2>
        <p class="text-stone/80 mb-7 leading-relaxed">Leadership development, service, and the Summer Academy extend the practice into accountability for something larger than yourself — where capability becomes contribution.</p>
        <GoldArrowLink href="/community/summer-academy" text="Explore the Summer Academy" class="mb-10 text-stone" />
        <ClaimRotator items={differentiators} label="What sets the academy apart" />
      </div>
    </div>
  </section>

  <!-- 9 · The Twelve Domains + Program structure (CLIENT ORIGINALITY — no source panel; relocated here to preserve the source spine Community→Life→Adventure) -->
  <section class="bg-navy text-stone relative overflow-hidden">
    <TopoTexture id="topo-houses" />
    <div class="container-content relative z-10 py-section-sm lg:py-section">
      <div class="text-center max-w-2xl mx-auto mb-10 reveal">
        <HighlightEyebrow pre="The Twelve" mark="Domains" class="justify-center mb-4 text-stone/70" />
        <h2 class="text-3xl lg:text-4xl text-stone mb-3 mt-2">Interconnected areas of development.</h2>
        <p class="text-stone/75 italic font-display text-xl">They are lenses, not destinations — areas of development, not ranks to achieve or stages to complete.</p>
        <p class="text-stone/70 mt-5 leading-relaxed">Within them, Eight Hands recommends a pathway suited to you — Academy Membership, Academy Scholar, or Academy Fellow (by invitation). Membership establishes your place within the academy; the pathway we recommend determines how you develop within it.</p>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 mb-16">
        {domains.map(([name, line], i) => (
          <div class="reveal border border-stone/15 bg-white/[0.04] p-5 hover:border-gold transition-colors">
            <div class="font-accent text-[11px] uppercase tracking-[0.16em] text-gold/70 mb-1">Domain {i + 1}</div>
            <div class="font-display text-2xl text-stone">{name}</div>
            <p class="mt-2 text-stone/70 text-sm italic leading-snug">{line}</p>
          </div>
        ))}
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        <div class="reveal bg-white/[0.04] border border-gold/30 p-8">
          <p class="eyebrow !text-gold mb-3">Individualized Instruction</p>
          <h3 class="text-2xl text-stone mb-3">The Core</h3>
          <p class="text-stone/75 text-sm">Assessment, mentorship, curriculum delivery, individual guidance, development planning, and personal accountability.</p>
        </div>
        <div class="reveal border border-stone/15 p-8">
          <p class="eyebrow !text-stone/70 mb-3">Group Instruction</p>
          <h3 class="text-2xl text-stone mb-3">The Application</h3>
          <p class="text-stone/75 text-sm">Repetition, conditioning, leadership, participation, partner development, community learning, and embodied application.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 10 · A Culture of Stewardship (replaces the testimonials carousel per client 2026-06-08) -->
  <section class="bg-navy text-stone relative overflow-hidden">
    <TopoTexture id="topo-voices" />
    <div class="container-content relative z-10 py-section max-w-3xl mx-auto reveal">
      <div class="text-center mb-8">
        <HighlightEyebrow pre="A Culture of" mark="Stewardship" class="justify-center text-stone/70" />
      </div>
      <div class="space-y-5 text-stone/80 leading-relaxed">
        <p>The strongest communities are built by individuals who choose to contribute. At the Qi-House, students are encouraged not only to pursue their own development, but also to support the growth of others through example, encouragement, and service.</p>
        <p>Learning becomes more meaningful when it is shared. Families reinforce habits at home, instructors provide guidance and accountability, and students learn that their actions influence the people around them. In this way, development becomes more than a personal achievement—it becomes a responsibility.</p>
        <p>Stewardship means leaving something stronger than you found it. Through participation, mentorship, and contribution, students help sustain a culture that benefits current members and future generations alike.</p>
      </div>
    </div>
  </section>

  <!-- 11 · A Preparation for Life — full-width photo band + offset text/photo -->
  <section class="bg-navy text-stone relative overflow-hidden">
    <TopoTexture id="topo-prep" />
    <div class="relative w-full aspect-[21/9] overflow-hidden">
      <div class="absolute inset-x-0 -top-16 -bottom-16 bg-gradient-to-br from-navy-700 to-navy-900 flex items-center justify-center" data-parallax="-52">
        <img src={withBase('/img/extra-1.jpg')} alt="" class="absolute inset-0 w-full h-full object-cover" />
      </div>
    </div>
    <div class="container-content relative z-10 py-section grid lg:grid-cols-2 gap-14 lg:gap-20 items-start">
      <div class="reveal lg:pt-6 lg:order-2">
        <HighlightEyebrow pre="A Preparation for" mark="Life" class="mb-5 text-stone/70" />
        <h2 class="text-3xl lg:text-4xl text-stone mb-6">Preparing people to lead and serve.</h2>
        <p class="text-stone/80 mb-8 leading-relaxed">Eight Hands exists to strengthen individuals, families, and communities — to develop people who can govern themselves and then contribute. We lead with a single question — <span class="font-display italic text-gold">how can we serve?</span></p>
        <GoldArrowLink href="/community/impact" text="Community Impact" class="text-stone" />
      </div>
      <!-- Layered cluster: large primary top-right + big secondary overhanging bottom-left, crossing left toward the copy. -->
      <div class="reveal relative min-h-[320px] lg:min-h-[420px] lg:order-1">
        <ParallaxPhoto img="/img/mentoring-2.jpg" imgAlt="A young student in a white uniform practicing a strike while an instructor looks on." alt="[IMAGE — service / contribution (primary) · LANDSCAPE 4:3 · 960×720px]" frameClass="aspect-[4/3] w-[88%] ml-auto" parallax={-104} innerClass="!text-xs" />
        <ParallaxPhoto img="/img/exterior-wide.jpg" imgAlt="The brick storefront of the Qi-House on Main Street in Longmont, Colorado." alt="[IMAGE — outdoor development (secondary) · LANDSCAPE 4:3 · 900×675px]" frameClass="absolute -bottom-6 left-0 lg:-left-16 w-[60%] aspect-[4/3] z-20 ring-[10px] ring-navy" parallax={-100} innerClass="!p-3 !text-[10px]" />
      </div>
    </div>
  </section>

  <!-- 12 · Community Impact — upcoming events the academy supports. Past events hide themselves; the whole
       section hides when none are left (data-ends / data-events-wrap, script in Base.astro). -->
  <section class="bg-navy text-stone relative overflow-hidden" data-events-wrap>
    <TopoTexture id="topo-news" />
    <div class="container-content relative z-10 py-section">
      <div class="flex items-end justify-between mb-8 reveal">
        <HighlightEyebrow pre="Community" mark="Impact" class="text-stone/70" />
        <GoldArrowLink href="/community/impact" text="More Ways We Serve" class="hidden sm:inline-flex text-stone" />
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 reveal">
        {events.map(({ title, date, ends, url, img }) => (
          <a href={url} target="_blank" rel="noopener" data-ends={ends} class="group flex flex-col border border-stone/15 bg-white/[0.04] overflow-hidden hover:border-gold transition-colors">
            <div class="relative aspect-[4/3] overflow-hidden bg-navy-700">
              {img
                ? <img src={withBase(img)} alt={title} loading="lazy" class="absolute inset-0 w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-105" />
                : <div class="absolute inset-0 flex items-center justify-center bg-gradient-to-br from-navy-700 to-navy-900">
                    <img src={withBase('/img/logo.png')} alt="" loading="lazy" class="w-20 h-20 object-contain opacity-70" />
                  </div>}
            </div>
            <div class="flex flex-col flex-1 p-6">
              <div class="font-accent uppercase tracking-[0.18em] text-[11px] text-gold/80 mb-3">{date}</div>
              <h3 class="font-display text-xl text-stone leading-snug mb-5 group-hover:text-gold transition-colors">{title}</h3>
              <span class="mt-auto font-accent text-[11px] uppercase tracking-[0.16em] text-stone/60 group-hover:text-gold transition-colors">Details →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>


  <!-- 13b · Testimonials (client brief 2026-10) — the six reviews shared with the Qi-House site -->
  <section id="reviews" class="bg-navy text-stone relative overflow-hidden">
    <TopoTexture id="topo-reviews" />
    <div class="container-content relative z-10 py-section">
      <div class="text-center max-w-2xl mx-auto mb-10 reveal">
        <HighlightEyebrow pre="In Their" mark="Words" class="justify-center mb-4 text-stone/70" />
        <h2 class="text-3xl lg:text-4xl text-stone mt-2 mb-4">What students say.</h2>
        <p class="inline-flex items-center gap-2 text-stone/80">
          <span class="text-gold tracking-[0.15em]" aria-hidden="true">★★★★★</span>
          <span><span class="font-semibold text-stone">{RATING.value}</span> out of 5 · {RATING.count} reviews</span>
        </p>
      </div>
      <div class="columns-1 md:columns-2 lg:columns-3 gap-5">
        {reviews.map(([name, paras]) => (
          <figure class="reveal break-inside-avoid mb-5 border border-stone/15 bg-white/[0.04] p-6">
            <div class="text-gold tracking-[0.15em] text-sm mb-3" role="img" aria-label="5 out of 5 stars">★★★★★</div>
            <blockquote class="space-y-3 text-stone/80 text-sm leading-relaxed">
              {paras.map((p) => <p>{p}</p>)}
            </blockquote>
            <figcaption class="mt-5 font-accent text-[11px] uppercase tracking-[0.16em] text-stone">{name}<span class="text-stone/45 normal-case tracking-normal"> · Google review</span></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- 13c · FAQ (client brief 2026-10) — shared with the Qi-House site -->
  <section id="faq" class="bg-navy text-stone relative overflow-hidden">
    <TopoTexture id="topo-faq" />
    <div class="container-content relative z-10 py-section max-w-3xl mx-auto">
      <div class="text-center mb-10 reveal">
        <HighlightEyebrow pre="Common" mark="Questions" class="justify-center mb-4 text-stone/70" />
        <h2 class="text-3xl lg:text-4xl text-stone mt-2">Questions families and adults ask us.</h2>
      </div>
      <div class="reveal border-t border-stone/15">
        {faqs.map(([q, a]) => (
          <details class="group border-b border-stone/15">
            <summary class="flex items-start justify-between gap-6 py-5 cursor-pointer list-none font-display text-xl text-stone hover:text-gold transition-colors">
              {q}
              <span class="text-gold text-2xl leading-none mt-0.5 transition-transform duration-200 group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="pb-6 pr-10 text-stone/75 leading-relaxed">{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 14 · Closing CTA — navy + topo + red CTA (matches source) -->
  <section class="bg-navy text-stone relative overflow-hidden">
    <TopoTexture id="topo-cta" />
    <div class="container-content relative z-10 py-section text-center reveal">
      <h2 class="text-3xl lg:text-5xl text-stone mb-6">See where you'd begin.</h2>
      <p class="text-lg text-stone/80 max-w-xl mx-auto mb-10">Your assessment is a conversation about your goals, challenges, and readiness — not a sales presentation. We listen, then recommend the pathway that fits.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href={BOOKING_URL} target="_blank" rel="noopener" class="btn-accent">Schedule an Assessment</a>
        <a href={withBase('/admissions#process')} class="btn-ghost !border-stone/40 !text-stone hover:!bg-stone hover:!text-navy">See the Admissions Process</a>
      </div>
    </div>
  </section>

  <!-- Off-canvas News & Events flyout -->
  <NewsFlyout />
</Base>
