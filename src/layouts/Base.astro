---
import '../styles/global.css';
import Header from '../components/Header.astro';
import HomeHeader from '../components/HomeHeader.astro';
import Footer from '../components/Footer.astro';
import SearchOverlay from '../components/SearchOverlay.astro';
import AssessmentPopup from '../components/AssessmentPopup.astro';
import { withBase, BRAND, CONTACT, SOCIAL, BOOKING_URL } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  home?: boolean;
}
const {
  title = 'Eight Hands Martial Arts Academy · The Qi-House',
  description = 'A Martial Arts Education in Self-Governance.',
  home = false,
} = Astro.props;

// Canonical + social-preview URLs, resolved against the production origin in astro.config.mjs.
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const socialImage = new URL(withBase('/img/interior-wide.jpg'), Astro.site).href;

// Local-business structured data, emitted on every page so any of them can be the search
// result that surfaces name, address, phone and the booking action.
const [streetAddress, addressLocality, regionZip] = CONTACT.address.split(',').map((s) => s.trim());
const [addressRegion, postalCode] = regionZip.split(/\s+/);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'SportsActivityLocation',
  name: BRAND.name,
  alternateName: BRAND.campus,
  description,
  url: canonicalUrl,
  telephone: CONTACT.phone,
  email: CONTACT.email,
  image: socialImage,
  address: {
    '@type': 'PostalAddress',
    streetAddress,
    addressLocality,
    addressRegion,
    postalCode,
    addressCountry: 'US',
  },
  hasMap: CONTACT.mapUrl,
  sameAs: [SOCIAL.facebook, SOCIAL.instagram, SOCIAL.tiktok, SOCIAL.yelp],
  potentialAction: {
    '@type': 'ReserveAction',
    name: 'Schedule an Assessment',
    target: BOOKING_URL,
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={BRAND.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />

    <link rel="icon" type="image/png" href={withBase('/favicon-512.png')} />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase('/favicon-32.png')} />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=Montserrat:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    {home && <HomeHeader />}
    <Header reveal={home} />
    <main>
      <slot />
    </main>
    <Footer />
    <SearchOverlay />
    <AssessmentPopup />

    <!-- Community events hide themselves once their last day (data-ends, YYYY-MM-DD) has passed, so the site never
         shows stale events between deploys. A [data-events-wrap] hides when none of its events remain: with no
         value it checks itself, with an id it checks that element (the News & Events tab checks its panel).
         Inline so it runs during parse, before the sections can paint. -->
    <script is:inline>
      (() => {
        const d = new Date();
        const today = [d.getFullYear(), String(d.getMonth() + 1).padStart(2, '0'), String(d.getDate()).padStart(2, '0')].join('-');
        document.querySelectorAll('[data-ends]').forEach((el) => { if (el.dataset.ends < today) el.remove(); });
        document.querySelectorAll('[data-events-wrap]').forEach((w) => {
          const scope = w.dataset.eventsWrap ? document.getElementById(w.dataset.eventsWrap) : w;
          if (!scope || !scope.querySelector('[data-ends]')) w.remove();
        });
      })();
    </script>

    <script>
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Reveals via IntersectionObserver + CSS (independent of ScrollTrigger → never freezes).
      const reveals = document.querySelectorAll<HTMLElement>('.reveal');
      if (reduce) {
        reveals.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px' }
        );
        reveals.forEach((el) => io.observe(el));

        // Photo parallax — MANUAL rAF/scroll driver (NOT ScrollTrigger). The StatMap PIN inserts
        // ~1700px of pin-spacing that repeatedly skewed ScrollTrigger's start/end math for every
        // trigger below it, freezing the parallax at its rest value even after refresh(). A manual
        // driver reads each element's LIVE layout position every frame, so it's immune to that.
        //
        // It translates the WHOLE element (translate3d) so the visible photo box moves relative to
        // its neighbours — the reference behaviour (the photo's top edge rises past the heading as you
        // scroll down). offsetTop chain = transform-independent layout position, so applying the
        // transform never feeds back into the measurement. NEGATIVE data-parallax = drifts up on
        // scroll-down; magnitude = px travelled from rest toward each extreme (total ≈ 2×).
        const pItems = [...document.querySelectorAll<HTMLElement>('[data-parallax]')].map((el) => ({
          el,
          d: parseFloat(el.dataset.parallax || '0'),
        }));
        const docTop = (el: HTMLElement) => {
          let t = 0;
          let n: HTMLElement | null = el;
          while (n) {
            t += n.offsetTop;
            n = n.offsetParent as HTMLElement | null;
          }
          return t;
        };
        const updateParallax = () => {
          const vh = window.innerHeight;
          const sy = window.scrollY;
          for (const it of pItems) {
            const h = it.el.offsetHeight;
            const center = docTop(it.el) + h / 2 - sy; // viewport-relative element center
            // Denominator uses h/4 (not h/2) so TALL elements aren't over-damped — the big primary photo
            // would otherwise barely move. p clamps to ±1 slightly before the element fully exits, so most
            // of the travel happens while it's on screen (more visible).
            let p = (center - vh / 2) / (vh / 2 + h / 4); // +1 entering (low) → 0 centred → -1 exiting (high)
            p = Math.max(-1, Math.min(1, p));
            it.el.style.transform = `translate3d(0, ${(-p * it.d).toFixed(1)}px, 0)`;
          }
        };
        // Update DIRECTLY on the scroll event (scroll is already coalesced to ~frame rate). No rAF gate:
        // transforms don't dirty layout, so the per-element offsetTop reads don't thrash, and this stays
        // responsive during fast scroll instead of dropping behind a throttled rAF queue.
        window.addEventListener('scroll', updateParallax, { passive: true });
        window.addEventListener('resize', updateParallax);
        window.addEventListener('load', updateParallax);
        if ((document as any).fonts?.ready) (document as any).fonts.ready.then(updateParallax);
        updateParallax();

        // StatMap pin still uses ScrollTrigger; refresh after layout/fonts settle.
        const refresh = () => ScrollTrigger.refresh();
        window.addEventListener('load', refresh);
        if ((document as any).fonts?.ready) (document as any).fonts.ready.then(refresh);
        setTimeout(refresh, 700);
      }
    </script>
  </body>
</html>
